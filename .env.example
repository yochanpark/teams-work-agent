# Bot Framework (비워 두면 인증 없이 로컬·에뮬레이터로 동작)
MicrosoftAppType=SingleTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# LLM — 둘 중 하나. OPENAI_API_KEY가 있으면 OpenAI, 없으면 Gemini(무료 등급)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Automation Anywhere (비워 두면 RPA 호출 없이 데모 모드)
AA_CONTROL_ROOM_URL=
AA_USERNAME=
AA_API_KEY=
AA_LEAVE_BOT_ID=
AA_RESOURCE_BOT_ID=
AA_RUN_AS_USER_IDS=

PORT=3978
